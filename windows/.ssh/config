# ===== Windows 用 SSH 設定 (dotfiles 管理: windows/.ssh/config) =====
# devbox: 全クライアント共通の入口 (#214 Phase 3)
# WezTerm(ネイティブSSHドメイン) はこのファイルを使わず .wezterm.lua の定義で接続する。
# ssh/scp/gh 等のコマンドラインからは `ssh devbox` で入る。
# devbox は自宅 Windows 機 (desktop) 上の Hyper-V Ubuntu VM (AUT-551。旧 Azure VM 100.126.96.27)。
# 接続は Tailscale 経由 (#214 Phase 4)。IP はノード固有で不変。MagicDNS: devbox.tail7bb5be.ts.net
# 認証は Tailscale SSH (tailnet policy で seiya を許可。check mode の再認証あり)
Host devbox
    HostName 100.124.128.55
    User seiya
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    ServerAliveCountMax 4

# rpa: UiPath RPA 用 Windows Server (Azure VM, AUTOFOR-RG)。Tailscale 経由。
# MagicDNS: rpa.tail7bb5be.ts.net
Host rpa
    HostName rpa.tail7bb5be.ts.net
    User azureuser
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    ServerAliveCountMax 4
