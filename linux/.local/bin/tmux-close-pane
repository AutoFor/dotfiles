#!/bin/sh
# 閉じたペインを開き直せるようにする (issue #242)。
# ウィンドウ版 tmux-close-window (#231) のペイン版。
#
# close: prefix + x x (2 連打) から呼ばれる。kill-pane する前に、そのペインの
#        cwd / ペイン名 (@name) / claude の会話 ID / ウィンドウ内での位置と
#        レイアウトを記録してから閉じる。
# undo:  prefix + X。直近の記録から復元する。記録はスタックなので連打すると
#        閉じた順に遡れる。
#
# ウィンドウ最後の 1 枚を閉じるときはウィンドウごと消えるので、記録も復元も
# tmux-close-window に委ねる (prefix + W で開き直せる)。
#
# 復元できるのは「構成」まで。動いていたコマンドは自動実行しない
# (プロンプトに打ちかけの危険なコマンドが残っていることがあるため)。
# 例外は claude で、記録した会話 ID があれば --resume で同じ会話に戻す。
set -eu

DIR="$HOME/.local/share/tmux/closed-panes"
PANE_DIR="$HOME/.local/share/tmux/claude-panes"   # ペイン ID → claude 会話 ID (tmux-claude-sessions track)
KEEP=20                                            # 保持する記録の数 (これより古いものから捨てる)
TAB=$(printf '\t')

# 記録ファイルは連番。数値順の末尾が「直近に閉じたペイン」
records() { ls -1 "$DIR" 2>/dev/null | grep -E '^[0-9]+$' | sort -n; }

# ペイン 1 枚分の構成を標準出力へ。空のフィールド (@name 未設定など) が
# 潰れないよう、行の分解には read ではなく cut を使う
# (IFS にタブを入れた read は連続タブを 1 つの区切りとして扱うため列がずれる)
record_pane() {
  pane=$1
  # pos = ウィンドウ内の並び順 (1 始まり)。pane_index はキル後に振り直される
  # ことがあるので、復元位置は「一覧の何番目か」で持つ
  win=$(tmux display-message -p -t "$pane" '#{window_id}')
  pos=$(tmux list-panes -t "$win" -F '#{pane_id}' | grep -n "^${pane}\$" | cut -d: -f1)
  sid=""
  [ -f "$PANE_DIR/${pane#%}" ] && sid=$(head -n 1 "$PANE_DIR/${pane#%}")
  tmux display-message -p -t "$pane" \
    "pane${TAB}#{session_name}${TAB}#{window_id}${TAB}#{window_index}${TAB}${pos}${TAB}#{pane_current_path}${TAB}#{@name}${TAB}${sid}${TAB}#{window_layout}"
}

do_close() {
  target=${1:-}
  [ -n "$target" ] || target=$(tmux display-message -p '#{pane_id}')

  # ウィンドウ最後の 1 枚ならウィンドウごと消える。記録も復元もウィンドウ版に任せる
  win=$(tmux display-message -p -t "$target" '#{window_id}')
  if [ "$(tmux display-message -p -t "$win" '#{window_panes}')" -le 1 ]; then
    exec sh "$HOME/.local/bin/tmux-close-window" close "$win"
  fi

  mkdir -p "$DIR"
  prev_seq=$(records | tail -n 1)
  rec="$DIR/$(( ${prev_seq:-0} + 1 ))"

  # 記録に失敗しても「閉じる」は止めない (閉じられない方が困る)
  if record_pane "$target" > "$rec.tmp" 2>/dev/null; then
    mv "$rec.tmp" "$rec"
    total=$(records | wc -l)
    if [ "$total" -gt "$KEEP" ]; then
      records | head -n $(( total - KEEP )) | while read -r old; do rm -f "$DIR/$old"; done
    fi
  else
    rm -f "$rec.tmp"
  fi

  tmux kill-pane -t "$target"
}

do_undo() {
  last=$(records | tail -n 1)
  if [ -z "${last:-}" ]; then
    tmux display-message "開き直せるペインはありません"
    return 0
  fi
  file="$DIR/$last"

  sess=$(cut -f2 "$file")
  win=$(cut -f3 "$file")
  widx=$(cut -f4 "$file")
  pos=$(cut -f5 "$file")
  path=$(cut -f6 "$file")
  pname=$(cut -f7 "$file")
  sid=$(cut -f8 "$file")
  layout=$(cut -f9 "$file")

  # 閉じたときのウィンドウが消えていたら、同名セッションのカレントウィンドウへ。
  # そのセッションも無ければ今いるウィンドウに出す
  if ! tmux list-panes -t "$win" >/dev/null 2>&1; then
    if tmux has-session -t "=$sess" 2>/dev/null; then
      win=$(tmux display-message -p -t "=$sess:" '#{window_id}')
    else
      win=$(tmux display-message -p '#{window_id}')
    fi
    layout=""   # 別のウィンドウに出すならレイアウトは当てはまらない
  fi

  # 閉じたときの並び順に戻す。pos 番目に入るよう、pos-1 番目のペインを分割する
  # (先頭だったなら先頭ペインの手前に -b で入れる)。並び順が合っていれば、
  # あとから流し込むレイアウト文字列と各ペインの対応が取れる
  if [ "${pos:-1}" -le 1 ]; then
    anchor=$(tmux list-panes -t "$win" -F '#{pane_id}' | head -n 1)
    new=$(tmux split-window -d -b -t "$anchor" -c "$path" -P -F '#{pane_id}')
  else
    anchor=$(tmux list-panes -t "$win" -F '#{pane_id}' | sed -n "$(( pos - 1 ))p")
    [ -n "$anchor" ] || anchor=$(tmux list-panes -t "$win" -F '#{pane_id}' | tail -n 1)
    new=$(tmux split-window -d -t "$anchor" -c "$path" -P -F '#{pane_id}')
  fi

  # 閉じる直前のレイアウトを流し込んで元の大きさ・位置に戻す
  [ -n "$layout" ] && tmux select-layout -t "$win" "$layout" >/dev/null 2>&1 || true

  [ -n "$pname" ] && tmux set -p -t "$new" @name "$pname"
  if [ -n "$sid" ] && ls "$HOME"/.claude/projects/*/"$sid".jsonl >/dev/null 2>&1; then
    tmux send-keys -t "$new" "claude --resume $sid --dangerously-skip-permissions" Enter
  fi

  rm -f "$file"
  tmux select-window -t "$win"
  tmux select-pane -t "$new"
  # ペイン名・claude 会話の位置キーが変わるので保存し直し、WezTerm のタブバーも更新する
  # (.tmux.conf の prefix+m / ! と同じ理由)
  sh "$HOME/.local/bin/wezterm-tabs-sync" >/dev/null 2>&1 || true
  sh "$HOME/.local/bin/tmux-resurrect-autosave" force >/dev/null 2>&1 || true
  tmux display-message "ペイン${pname:+ '$pname'}を開き直しました (${sess}:${widx})"
}

case "${1:-}" in
close|"") do_close "${2:-}" ;;
undo)     do_undo ;;
list)
  records | while read -r r; do
    printf '%s\t%s\n' "$r" "$(awk -F "$TAB" '{print $2":"$4" pos="$5" "$6; exit}' "$DIR/$r")"
  done
  ;;
*)
  echo "usage: tmux-close-pane [close [pane-id]|undo|list]" >&2
  exit 1
  ;;
esac
