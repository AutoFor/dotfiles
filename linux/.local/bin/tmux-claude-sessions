#!/bin/sh
# claude ペインの会話 (セッション ID) を tmux-resurrect の復元で引き継ぐ。
# 従来の `claude --continue` は「同じ cwd の最新の会話」を開くため、1 ウィンドウに
# 同一プロジェクトのペインが複数あると復元後に全ペインが同じ会話になってしまう。
# ペインごとにセッション ID を記録しておき、復元時は --resume で個別に再開する。
#
# track:  Claude Code の SessionStart hook (~/.claude/settings.json) から呼ばれる。
#         stdin の hook JSON から session_id を取り、ペイン ID → セッション ID を記録
# save:   resurrect の post-save-all フック (.tmux.conf) から呼ばれる。
#         track の記録を生存ペインの位置で TSV 化。位置キーは「セッション名 + ウィンドウ名
#         + ペイン番号」。ウィンドウ番号は renumber-windows で繰り上がる (ウィンドウを
#         閉じる / prefix+M で別セッションへ移動する等) と全ズレするため主キーにしない。
# resume: resurrect の復元コマンド (@resurrect-processes) として claude ペイン内で
#         実行される。TSV に自ペインの記録があれば --resume、なければ新規で開く
set -eu

PANE_DIR="$HOME/.local/share/tmux/claude-panes"
FILE="$HOME/.local/share/tmux/resurrect/claude-sessions.tsv"
# 復元時に「1 つの会話 = 1 ペイン」を保証するための予約置き場。
# ディレクトリを mkdir で作れたペインだけがその会話を開く (mkdir は同一 FS 上で
# アトミックなので、復元で全ペインの shell が同時に走っても二重取得にならない)。
# 中の owner ファイルには占有者のペイン位置を書き、tmux-autorestore が復元前に
# 記録済み会話を先に予約しておけるようにする。
CLAIM_DIR="$HOME/.local/share/tmux/claude-claims"
TAB=$(printf '\t')

case "${1:-}" in
track)
  # tmux 外 (Windows や wezterm mux 直下) では何もしない
  [ -n "${TMUX_PANE:-}" ] || exit 0
  if command -v jq >/dev/null 2>&1; then
    SID=$(jq -r '.session_id // empty' 2>/dev/null)
  else
    SID=$(sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
  fi
  [ -n "$SID" ] || exit 0
  mkdir -p "$PANE_DIR"
  printf '%s\n' "$SID" > "$PANE_DIR/${TMUX_PANE#%}"
  ;;
save)
  mkdir -p "$(dirname "$FILE")" "$PANE_DIR"
  # 列: session_name  window_index  window_name  pane_index  pane_id
  PANES=$(tmux list-panes -a -F "#{session_name}${TAB}#{window_index}${TAB}#{window_name}${TAB}#{pane_index}${TAB}#{pane_id}")
  # 閉じたペインの記録を掃除 (ペイン ID はサーバー再起動で振り直されるため、
  # 残しておくと無関係な新ペインの記録として誤読される)
  for f in "$PANE_DIR"/*; do
    [ -e "$f" ] || continue
    printf '%s\n' "$PANES" | cut -f5 | grep -qx "%$(basename "$f")" || rm -f "$f"
  done
  # 同じ会話 ID が複数ペインに紐づいていたら最初の 1 ペインだけ残す。
  # 一度でも複数ペインが同じ会話を開いてしまうと (下の resume のフォールバック参照)
  # 各ペインの SessionStart hook が同じ ID を記録し、以後の復元が --resume で
  # その重複を忠実に再現し続ける。ここで落とさないと汚染が永久に再生産される
  # (2026-08-01 の復元失敗を起点に、2026-08-02 まで 3 会話 7 プロセスが継続した)
  # 出力列: session_name  window_name  pane_index  window_index  session_id
  # (照合の主キーは名前。番号 w はフォールバック用に 4 列目に残す)
  printf '%s\n' "$PANES" | while IFS="$TAB" read -r s w wn p id; do
    [ -r "$PANE_DIR/${id#%}" ] || continue
    sid=$(head -n 1 "$PANE_DIR/${id#%}")
    [ -n "$sid" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$s" "$wn" "$p" "$w" "$sid"
  done | awk -F '\t' '!seen[$5]++' > "$FILE.tmp"
  # 上書き前に旧版を 3 世代残す (claude-sessions.tsv.1 〜 .3)。
  # 一点物のまま復元失敗直後の保存に空で潰されると、どのペインがどの会話だったか
  # 永久に分からなくなる (2026-08-01 に実際に発生)
  if [ -s "$FILE" ] && ! cmp -s "$FILE.tmp" "$FILE"; then
    rm -f "$FILE.3"
    if [ -f "$FILE.2" ]; then mv "$FILE.2" "$FILE.3"; fi
    if [ -f "$FILE.1" ]; then mv "$FILE.1" "$FILE.2"; fi
    cp -p "$FILE" "$FILE.1"
  fi
  mv "$FILE.tmp" "$FILE"
  ;;
resume)
  ME="?"
  SID=""
  if [ -n "${TMUX_PANE:-}" ]; then
    POS=$(tmux display-message -p -t "$TMUX_PANE" "#{session_name}${TAB}#{window_name}${TAB}#{window_index}${TAB}#{pane_index}")
    s=${POS%%"$TAB"*}; rest=${POS#*"$TAB"}
    wn=${rest%%"$TAB"*}; rest=${rest#*"$TAB"}
    w=${rest%%"$TAB"*}; p=${rest#*"$TAB"}
    # 予約キー (owner) もウィンドウ名ベースにして、番号繰り上げが起きても
    # tmux-autorestore が先に置いた予約と一致させる
    ME="$s:$wn.$p"
    if [ -r "$FILE" ]; then
      # ウィンドウ名で照合 → 無ければウィンドウ番号でフォールバック。
      # 旧 4 列形式 (s  window_index  pane_index  sid) の TSV も NF==4 で拾う。
      SID=$(awk -F '\t' -v s="$s" -v wn="$wn" -v w="$w" -v p="$p" '
        $1 != s { next }
        NF >= 5 {
          if ($2 == wn && $3 == p && nm == "") nm = $5
          if ($4 == w  && $3 == p && ix == "") ix = $5
        }
        NF == 4 {
          if ($2 == w && $3 == p && ox == "") ox = $4
        }
        END { print (nm != "" ? nm : (ix != "" ? ix : ox)) }
      ' "$FILE")
    fi
  fi

  # 会話 ID を 1 ペインだけに割り当てる。既に他ペインのものなら失敗を返す。
  # tmux-autorestore が先に置いた予約は owner が自分と一致すれば引き取れる
  claim() {
    d="$CLAIM_DIR/$1"
    mkdir -p "$CLAIM_DIR"
    # 10 分以上前の予約は前回の復元の残骸 (手動 prefix+Ctrl-r 等) とみなして捨てる
    if [ -d "$d" ] && [ -z "$(find "$d" -maxdepth 0 -mmin -10 2>/dev/null)" ]; then
      rm -rf "$d"
    fi
    if mkdir "$d" 2>/dev/null; then
      printf '%s\n' "$ME" > "$d/owner"
      return 0
    fi
    [ "$(cat "$d/owner" 2>/dev/null)" = "$ME" ]
  }

  # 記録が古い等で会話の実体 (transcript) が無ければ記録は無かったことにする
  if [ -n "$SID" ] && ! ls "$HOME"/.claude/projects/*/"$SID".jsonl >/dev/null 2>&1; then
    SID=""
  fi
  if [ -n "$SID" ] && claim "$SID"; then
    exec claude --resume "$SID" --dangerously-skip-permissions
  fi

  # --- 記録が無い / 会話を他ペインに取られたペインのフォールバック ---
  # 以前は `claude --continue` にしていたが、これは「その cwd の最新の会話」を開くため
  # 同じ cwd のペインが複数あると全員が同じ会話を掴み、1 つの transcript を複数
  # プロセスが奪い合う (2026-08-01 の復元失敗でこの経路に落ち、life ウィンドウの
  # 3 ペインが同一会話になった)。
  # 「最新のうちまだ予約されていない会話」を選ぶ案も試したが、tmux 外で動いている
  # Claude Code (Claude Code Desktop 等) の進行中の会話が最新に来ることがあり、
  # そちらを横取りしてしまう。transcript は開きっぱなしにならないので fuser でも
  # 使用中か判定できない。当てずっぽうで拾うより、会話を引き継がず新規で開く。
  # 元の会話に戻したいときはそのペインで /resume から選び直す
  exec claude --dangerously-skip-permissions
  ;;
*)
  echo "usage: tmux-claude-sessions track|save|resume" >&2
  exit 1
  ;;
esac
