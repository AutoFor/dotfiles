#!/bin/sh
# tmux サーバー起動直後に resurrect の復元を一度だけ実行する (.tmux.conf 末尾から起動)。
#
# 以前は tmux-continuum の自動復元を使っていたが、continuum は「自分以外の tmux
# プロセスが 2 つ以上いたら別サーバーが動いているとみなして復元をスキップ」する
# 判定を持ち、本構成では client-attached フック (wezterm-tabs-sync) が起動直後に
# 発行する tmux コマンドと競合して不発になることがある (2026-07-21 に実際に発生。
# さらに直後の cron 保存がまっさらな状態で last を上書きしてしまう)。
# continuum をやめ、このスクリプトで条件判定なしに確実に復元する。
set -eu

# 設定リロード (prefix+r / source-file) でも run-shell が再実行されるため、
# サーバー環境変数へのマーキングで「このサーバーで一度きり」にする
if tmux show-environment -g TMUX_AUTORESTORE_DONE >/dev/null 2>&1; then
  exit 0
fi
tmux set-environment -g TMUX_AUTORESTORE_DONE 1

# 念のための二重ガード: サーバー起動直後 (60 秒以内) 以外は復元しない
START=$(tmux display-message -p '#{start_time}')
NOW=$(date +%s)
if [ $((NOW - START)) -gt 60 ]; then
  # 復元対象外 (稼働中サーバーで初めて実行された場合等)。自動保存だけ許可する
  tmux set-environment -g TMUX_AUTORESTORE_FINISHED 1
  exit 0
fi

# .tmux.conf の残り (resurrect のオプション類) の読み込み完了を待ってから復元
sleep 2

LOG="$HOME/.cache/tmux-autorestore.log"
mkdir -p "$(dirname "$LOG")"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

# 再起動直後は PATH やネットワーク越しのマウント等の初期化が restore.sh の実行に
# 間に合わないことがあり、ウィンドウ・ペインの復元が一部/全部失敗してペイン数 1
# のまま終わることがある。restore.sh はエラーを internally 握りつぶすため、
# その失敗に気づかず FINISHED を立てると直後の cron 保存が「復元し損ねた空の
# 状態」を last として固定し、保存済みの復元素材を潰してしまう
# (2026-07-27 朝: 9 ウィンドウ・13 ペインの保存があったのに 1 ペインに退化して
# 上書きされた)。復元後のペイン数を保存ファイルのペイン数と突き合わせ、
# 不足していれば少し待って再試行する。
LAST_FILE="$HOME/.local/share/tmux/resurrect/last"
# last が実体のないファイルを指している (保存側の競合で発生しうる) 場合は、
# 現存する最新スナップショットに貼り替えてから復元する。これをやらないと
# 復元素材ゼロとみなして 1 ペインのまま起動し、直後の cron 保存がその
# まっさらな状態を last として固定してしまう
"$HOME/.local/bin/tmux-resurrect-repair-last" || true

expected_panes=0
if [ -f "$LAST_FILE" ]; then
  # grep -c は一致 0 件でも "0" を出力した上で終了コード 1 を返すため、
  # `|| echo 0` をコマンド置換の中に置くとフォールバックも実行されて
  # "0\n0" のような複数行になり、後段の数値比較が set -eu で異常終了する
  # (2026-07-28 朝: この不具合で復元検証が正しく機能しなかった)。
  # フォールバックは代入文レベルで行う。
  expected_panes=$(grep -c '^pane' "$LAST_FILE" 2>/dev/null) || expected_panes=0
fi

attempt=1
actual_panes=0
while :; do
  "$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh" >>"$LOG" 2>&1 || true
  actual_panes=$(tmux list-panes -a 2>/dev/null | wc -l | tr -d ' ')
  log "restore attempt=$attempt expected_panes=$expected_panes actual_panes=$actual_panes"
  if [ "$actual_panes" -ge "$expected_panes" ] || [ "$attempt" -ge 5 ]; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 5
done

if [ "$actual_panes" -lt "$expected_panes" ]; then
  # 自動保存を止めたまま抜ける。ここで FINISHED を立てると 15 分以内に走る
  # cron 保存が「復元し損ねた 1 ペインの状態」で last / pane-names.tsv /
  # claude-sessions.tsv を上書きし、残っていた復元素材まで消えてしまう
  # (2026-08-01 16:00 に実際に発生し、ペイン名と claude セッション ID を失った)。
  # 復旧後は手動保存 (prefix + Ctrl-s) か、下記コマンドで保存を再開する:
  #   tmux set-environment -g TMUX_AUTORESTORE_FINISHED 1
  log "復元が不完全 (expected=$expected_panes actual=$actual_panes)。自動保存を停止したまま手動確認を待つ"
  tmux display-message "tmux復元が不完全 (期待${expected_panes}ペイン/実際${actual_panes}ペイン)。自動保存は停止中 — ${LOG} を確認"
  exit 0
fi

# 復元が完了してから cron の自動保存 (tmux-resurrect-autosave) を許可する。
# 復元完了前に保存が走ると、まっさらな状態で last や pane-names.tsv を上書きし、
# 復元素材を潰してしまう (2026-07-22 朝: ペイン名がこのレースで消えた)
tmux set-environment -g TMUX_AUTORESTORE_FINISHED 1
