#!/bin/sh
# Windows PC (aura) の PowerShell を devbox の tmux ウィンドウとして開く (#253)。
# Tailscale 経由で Windows の OpenSSH Server に入る (linux/.ssh/config の Host aura、
# Windows 側は windows/bin/setup-sshd.ps1 で構築)。
#
# なぜ WezTerm のタブではなく tmux の窓にするか:
#   ローカル PowerShell を WezTerm のタブにすると、セッション層が Windows と Linux で
#   分かれ、タブバー・キー操作・復元が二重になる。tmux の窓にすれば他の窓と同じく
#   Ctrl+Tab / Alt+, で扱え、WezTerm を閉じても tmux が持ち、resurrect で戻る。
#
# なぜラッパーが要るか (~/.local/bin/rpa と同じ理由):
#   Windows PC のスリープや再起動で ssh が切れると、素の ssh ではペインごと窓が消え、
#   resurrect の保存対象からも落ちる。切れてもペインを終わらせず、Enter で再接続する。
#
# 使い方: aura [connect|status]
#   connect : ssh で入る。切れても終了せず Enter で再接続 (既定)
#   status  : ssh 到達性を表示
set -u

HOST=${AURA_HOST:-aura}        # ~/.ssh/config の Host 名
IP=${AURA_IP:-100.119.138.119} # Tailscale IP
# Windows 側の dotfiles。ssh セッション用の初期化 (文字コード UTF-8、プロンプトごとに
# cwd を端末タイトルへ → tmux のステータス行に出る) を windows/bin/tmux-shell.ps1 が行う。
# 無ければ (pull 前など) 素の pwsh で入る
WIN_DOTFILES=${AURA_DOTFILES:-'C:\Users\saint\ghq\github.com\AutoFor\dotfiles'}
TMUX_SHELL="$WIN_DOTFILES\windows\bin\tmux-shell.ps1"
# sshd は DefaultShell (pwsh) に -c で渡すので、リモートコマンドは pwsh 構文で書く
REMOTE_CMD="if (Test-Path '$TMUX_SHELL') { pwsh -NoLogo -NoExit -File '$TMUX_SHELL' } else { pwsh -NoLogo }"

ssh_reachable() {
  timeout 5 nc -z "$IP" 22 >/dev/null 2>&1
}

# tmux の窓に印を付ける。ステータス行 (status-left) は @host を見て
# 「devbox + cwd + ブランチ」の代わりに「pwsh @aura」を出す (中身は Windows なので
# devbox 側の cwd やブランチを出しても意味が無い)。窓名も pwsh に固定する
setup_tmux_window() {
  [ -n "${TMUX:-}" ] || return 0
  tmux set-option -p @host aura 2>/dev/null || true
  tmux set-option -w allow-rename off 2>/dev/null || true
  tmux rename-window pwsh 2>/dev/null || true
}

case "${1:-connect}" in
status)
  echo "aura: ssh到達 $(ssh_reachable && echo OK || echo NG)"
  ;;

connect)
  setup_tmux_window
  # ペインを終わらせないための無限ループ。resurrect が復元したときもここに戻る
  while :; do
    if ssh_reachable; then
      ssh -t "$HOST" "$REMOTE_CMD"
      code=$?
      echo ""
      if [ "$code" -eq 0 ]; then
        echo "aura (PowerShell) との接続を終了しました。"
      else
        echo "aura (PowerShell) との接続が切れました (exit $code)。PC のスリープや再起動でもここに来ます。"
      fi
    else
      echo ""
      echo "aura に届きません (PC が停止中か Tailscale が切れています)。"
    fi
    printf 'Enter で再接続 / Ctrl-C で抜ける > '
    read -r _ || exit 0
  done
  ;;

*)
  echo "usage: aura [connect|status]" >&2
  exit 1
  ;;
esac
