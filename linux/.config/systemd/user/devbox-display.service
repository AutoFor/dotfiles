# devbox の常設の仮の画面 :99(Xvfb + openbox)。
# Chrome を実画面で動かすワーカー(MF のスクレイパ・実現ワーカー等)は DISPLAY=:99 を使う。
# 人が覗くときは devbox-vnc / devbox-novnc 経由で手元のブラウザから見る(RDP 不要)。
[Unit]
Description=常設の仮の画面 :99 (Xvfb + openbox)

[Service]
ExecStart=/usr/bin/Xvfb :99 -screen 0 1600x1000x24 -nolisten tcp
# 画面が上がってからウィンドウマネージャを載せる(ウィンドウの移動・最大化のため)
ExecStartPost=/bin/sh -c 'for i in $(seq 50); do [ -e /tmp/.X11-unix/X99 ] && break; sleep 0.1; done; DISPLAY=:99 /usr/bin/openbox >/dev/null 2>&1 &'
Restart=on-failure

[Install]
WantedBy=default.target
