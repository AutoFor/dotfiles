# rpa (UiPath 用 Windows Server, Azure VM) へ Tailscale 経由で入る (#238)。
#
# WezTerm のタブから直接 ssh すると、その ssh は Windows 側の WezTerm の子プロセスに
# なるため、WezTerm を閉じた時点でセッションが失われる (この構成の永続化は devbox の
# tmux サーバーが担っており、WezTerm 側は状態を持たない)。
# そこで rpa へは「devbox の tmux セッション rpa の中から」この設定で入る。
# こうすると他のセッションと同じく resurrect の復元対象になり、WezTerm を閉じても
# 回線が切れても、実行中のプロセスごと残る。
Host rpa
    HostName 100.118.192.14
    User azureuser
    IdentityFile ~/.ssh/id_ed25519
    # 離席中に無言で切られるのを防ぐ (windows/.wezterm.lua 側の ecf294b と同じ意図)
    ServerAliveInterval 30
    ServerAliveCountMax 6
    StrictHostKeyChecking accept-new
    ConnectTimeout 10
